# Linux-Deployment-Dateien immer mit LF (systemd/Caddy/Shell vertragen kein CRLF gut)
deploy/** text eol=lf
*.service text eol=lf
*.sh text eol=lf
backend/run_webapp.py text eol=lf
backend/run.py text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
# Mitgelieferte Test-Datenbank ist binär – niemals Zeilenenden normalisieren
deploy/windows/mobilfunk.sample.db binary
# Word-Vorlagen sind binär (ZIP-Container) – niemals als Text behandeln
*.docx binary
*.dotx binary
