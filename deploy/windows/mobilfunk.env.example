# In PowerShell laden: . .\mobilfunk.env.ps1
$env:MOBILFUNK_DATA_DIR = "$env:PROGRAMDATA\Mobilfunkverwaltung"
$env:MOBILFUNK_WEBCONFIG_DIR = "$env:PROGRAMDATA\Mobilfunkverwaltung"
# Für Produktion einen zufälligen Wert setzen; niemals committen.
$env:MOBILFUNK_SECRET = "BITTE_EIN_EIGENES_SECRET_SETZEN"
$env:MOBILFUNK_HOST = "127.0.0.1"
$env:MOBILFUNK_PORT = "8000"
